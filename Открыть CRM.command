#!/bin/bash
# ============================================================
#  CRM Овсянников — запуск одним кликом
#  CRM открывается СРАЗУ, данные из Google Таблицы
#  обновляются в фоне. Использует встроенный Python.
# ============================================================

cd "$(dirname "$0")" || exit 1
PORT=3457
PY=/usr/bin/python3

clear
echo "════════════════════════════════════════════"
echo "   CRM Овсянников"
echo "════════════════════════════════════════════"
echo ""

# 1. Освобождаем порт, если CRM уже была запущена
if lsof -ti tcp:$PORT >/dev/null 2>&1; then
    lsof -ti tcp:$PORT | xargs kill -9 2>/dev/null
    sleep 1
fi

# 2. Запускаем локальный веб-сервер (мгновенно, без интернета)
echo "→ Запускаю CRM…"
"$PY" -m http.server $PORT --bind 127.0.0.1 >/tmp/ovsyannikov-crm.log 2>&1 &
SERVER_PID=$!
sleep 2

# 3. Сразу открываем в браузере (данные уже сохранены локально)
open "http://localhost:$PORT"
echo ""
echo "════════════════════════════════════════════"
echo "  ✓ CRM ОТКРЫТА В БРАУЗЕРЕ"
echo "════════════════════════════════════════════"
echo ""

# 4. В фоне обновляем данные из Google Таблицы (не блокирует CRM)
if [ -f "import/sync_sheets.py" ] && [ -f "sanya-498120-cee43b3a5917.json" ]; then
    echo "  ⏳ Обновляю данные из Google Таблицы в фоне…"
    echo "     (когда закончу — напишу ниже; затем обновите"
    echo "      страницу в браузере клавишами Cmd+R)"
    echo ""
    (
        if "$PY" -W ignore import/sync_sheets.py >/tmp/ovsyannikov-sync.log 2>&1; then
            echo ""
            echo "  ✓ ДАННЫЕ ОБНОВЛЕНЫ — нажмите в браузере Cmd+R, чтобы увидеть свежие."
            grep -E "Заказов|Выручка" /tmp/ovsyannikov-sync.log
        else
            echo ""
            echo "  ⚠ Не удалось обновить из таблицы (нет интернета?)."
            echo "    CRM работает на последних сохранённых данных."
        fi
    ) &
fi

echo "  ВАЖНО: это окно держите открытым (можно свернуть)."
echo "  Чтобы закрыть CRM — закройте это окно."
echo ""

# Останавливаем сервер при закрытии окна
trap "kill $SERVER_PID 2>/dev/null" EXIT
wait $SERVER_PID
